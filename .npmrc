# This app (TanStack Start + TanStack Router code-splitter) relies on tools that
# do bare require() calls assuming a FLAT node_modules — e.g. @babel/core doing
# require('@babel/helper-compilation-targets'). pnpm's default isolated layout
# hides those transitive modules and breaks the dev server / build with
# "Cannot find module '@babel/helper-compilation-targets'".
#
# Installing with a hoisted (flat) layout — the same layout npm and bun use, and
# the one this app was authored for — resolves it. Reinstall after changing this:
#   rm -rf node_modules pnpm-lock.yaml && pnpm install
node-linker=hoisted
