model Opportunity {
  id                  String    @id @default(cuid())
  recordType          String?   @map("record_type")
  contactId           String?   @map("contact_id")
  contact             String?   @map("contact")
  relatedListingId    String?   @map("related_listing_id")
  relatedListing      String?   @map("related_listing")
  ownerId             String?   @map("owner_id")
  owner               String?   @map("owner")
  /// An opportunity owner is EITHER a User (owner_id) OR a Role (owner_role, a
  /// @yachtway/shared RoleSchema key). EasyFund/MasterCover opps auto-own to
  /// FINTECH via owner_role. Not FK-constrained (role keys live in `roles`).
  ownerRole           String?   @map("owner_role")
  createdDate         DateTime? @map("created_date")
  opportunityStatus   String?   @map("opportunity_status")
  lastStageChangeDate DateTime? @map("last_stage_change_date")
  opportunityAmount   Decimal?  @map("opportunity_amount") @db.Decimal(14, 2)
  opportunityClosed   DateTime? @map("opportunity_closed") @db.Date
  name                String?   @map("name")
  stage               String?   @map("stage")
  opportunityPipeline String?   @map("opportunity_pipeline")
  /// Structured pipeline/stage FKs (CRM-native). The free-string `stage` /
  /// `opportunityPipeline` above are retained for GHL dual-write back-compat.
  pipelineId          String?   @map("pipeline_id")
  stageId             String?   @map("stage_id")
  utmCampaign         String?   @map("utm_campaign")
  utmContent          String?   @map("utm_content")
  utmMedium           String?   @map("utm_medium")
  utmSource           String?   @map("utm_source")
  vesselMake          String?   @map("vessel_make")
  vesselModel         String?   @map("vessel_model")
  vesselYear          String?   @map("vessel_year")
  createdById         String?   @map("created_by_id")
  createdBy           String?   @map("created_by")
  lostReason          String?   @map("lost_reason")
  /// Sync dedupe key — mirrors the sync service's OpportunityRef.upsertKey so
  /// every platform-sourced opportunity (EasyFund/MasterCover/New Dealer Signups)
  /// dual-writes idempotently even without an external id. NULL for opportunities
  /// born in the CRM (rep-entered, studio booking) — those are not sync-sourced.
  syncSourceKey       String?   @unique @map("sync_source_key")

  // --- relations ---
  contactRecord          Contact?                   @relation("OpportunityContact", fields: [contactId], references: [id])
  relatedListingRecord   Listing?                   @relation("OpportunityListing", fields: [relatedListingId], references: [id])
  ownerUser              User?                      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  pipeline               Pipeline?                  @relation("OpportunityPipeline", fields: [pipelineId], references: [id])
  stageRecord            PipelineStage?             @relation("OpportunityStage", fields: [stageId], references: [id])
  stageHistory           OpportunityStageHistory[]  @relation("StageHistoryOpportunity")
  easyFundLoan           EasyFundLoan?
  masterCoverApplication MasterCoverApplication?
  studioDetail           StudioDetail?
  lineItems              OpportunityLineItem[]
  invoices               Invoice[]                  @relation("InvoiceOpportunity")
  studioShootCredits     StudioShootCredit[]        @relation("ShootCreditOpportunity")
  partnerReceivable      PartnerReceivable?         @relation("PartnerReceivableOpportunity")
  payout                 Payout?                    @relation("PayoutOpportunity")

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([relatedListingId])
  @@index([ownerId])
  @@index([createdById])
  @@index([stage])
  @@index([pipelineId])
  @@index([stageId])
  @@map("opportunities")
}

/// Opportunity pipeline (reference/config). Seeded from @yachtway/shared
/// PIPELINE_SEED. `sensitivityClass` marks financing pipelines (easyfund /
/// mastercover) whose opportunity rows are hidden from callers lacking the grant.
model Pipeline {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  displayOrder     Int      @map("display_order")
  sensitivityClass String?  @map("sensitivity_class")
  lostReasons      String[] @map("lost_reasons")
  isActive         Boolean  @default(true) @map("is_active")

  stages        PipelineStage[]           @relation("PipelineStages")
  opportunities Opportunity[]             @relation("OpportunityPipeline")
  stageHistory  OpportunityStageHistory[] @relation("StageHistoryPipeline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pipelines")
}

/// A stage within a pipeline. `position` orders the funnel; outcome flags feed
/// Phase 5 conversion/velocity reporting.
model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String   @map("pipeline_id")
  key        String
  name       String
  position   Int
  isClosed   Boolean  @default(false) @map("is_closed")
  isWon      Boolean? @map("is_won")

  pipeline         Pipeline                  @relation("PipelineStages", fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities    Opportunity[]             @relation("OpportunityStage")
  historyFromStage OpportunityStageHistory[] @relation("StageHistoryFrom")
  historyToStage   OpportunityStageHistory[] @relation("StageHistoryTo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pipelineId, key])
  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

/// Append-only record of every stage move. Written from day one — velocity and
/// conversion metrics cannot be reconstructed after the fact. Name snapshots
/// (`fromStage`/`toStage`) preserve history across stage renames/reorders.
model OpportunityStageHistory {
  id            String   @id @default(cuid())
  opportunityId String   @map("opportunity_id")
  pipelineId    String?  @map("pipeline_id")
  fromStageId   String?  @map("from_stage_id")
  toStageId     String?  @map("to_stage_id")
  fromStage     String?  @map("from_stage")
  toStage       String?  @map("to_stage")
  changedById   String?  @map("changed_by_id")
  changedByRole String?  @map("changed_by_role")
  note          String?
  changedAt     DateTime @default(now()) @map("changed_at")

  opportunity Opportunity    @relation("StageHistoryOpportunity", fields: [opportunityId], references: [id], onDelete: Cascade)
  pipeline    Pipeline?      @relation("StageHistoryPipeline", fields: [pipelineId], references: [id])
  from        PipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id])
  to          PipelineStage? @relation("StageHistoryTo", fields: [toStageId], references: [id])

  @@index([opportunityId])
  @@index([toStageId])
  @@index([changedAt])
  @@map("opportunity_stage_history")
}

