  hullType                        String?   @map("hull_type")
  leadSource                      String?   @map("lead_source")
  loan                            Boolean?  @map("loan")
  loanAmount                      Decimal?  @map("loan_amount") @db.Decimal(14, 2)
  mastercoverId                   String?   @unique @map("mastercover_id")
  notes                           String?   @map("notes")
  numberCrewOnboard               Decimal?  @map("number_crew_onboard")
  opportunityCreated              DateTime? @map("opportunity_created") @db.Date
  creditedToReferringDealer       Decimal?  @map("credited_to_referring_dealer") @db.Decimal(14, 2)
  policyEffectiveDate             DateTime? @map("policy_effective_date") @db.Date
  policyStatus                    String?   @map("policy_status")
  estimatedPremium                Decimal?  @map("estimated_premium") @db.Decimal(14, 2)
  referralToDealer                Decimal?  @map("referral_to_dealer")
  referralFeeAddedToDealerAccount Boolean?  @map("referral_fee_added_to_dealer_account")
  tenderHpPerEngine               Decimal?  @map("tender_hp_per_engine")
  tenderMake                      String?   @map("tender_make")
  tenderModel                     String?   @map("tender_model")
