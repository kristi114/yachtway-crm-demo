// ============================================================================
// YachtWay CRM — core data model (Prisma / PostgreSQL)
//
// GENERATED 2026-07-20 from "YachtWay CRM - Proposed Field Catalog (BE-aligned).xlsx"
// via prisma/gen-from-catalog.py, then relation/index/isolation rules layered on.
// Strict alignment: the catalog is the source of truth for every column name and
// type. Company == the account entity (table "companies"); Contact unions the
// Broker and Buyer field sets under one record_type discriminator.
//
// Sensitive-domain isolation is INTENTIONAL: EasyFundLoan, MasterCoverApplication,
// and financing-classed Conversations live in their own tables / carry a
// sensitivity_class so access is enforced by Postgres RLS, never per-column masks.
//
// "<lookup>Label" style scalar columns (owner, company, dealer, ...) are kept from
// the catalog beside each real FK: sync/backfill carries the source's display
// label even before the related record exists, then reconciles.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime: least-privilege crm_app role (RLS applies).
  url = env("DATABASE_URL")
  // Migrations / shadow DB / introspection: the owner (crm) role, which has the
  // DDL + CREATE DATABASE rights that crm_app deliberately lacks. Prisma Migrate
  // uses directUrl; the generated client always uses url.
  directUrl = env("ADMIN_DATABASE_URL")
}

// Brand lookup — replaces the 1,000+-option Multi-Picklist on
// Company.authorized_brands and Contact.brand_interests (build-plan design rule).
model Brand {
  id        String   @id @default(cuid())
  /// Display name (preserves the casing an admin typed)
  name      String   @unique
  /// Normalized dedupe key (trimmed + lowercased) — "Sea Ray" and "sea ray" collapse
  nameKey   String   @unique @map("name_key")
  active    Boolean  @default(true)
  /// picklist ordering (0 first); ties break by name
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  authorizedByCompanies Company[] @relation("CompanyAuthorizedBrands")
  interestedContacts    Contact[] @relation("ContactBrandInterests")

  @@index([sortOrder])
  @@map("brands")
}

// Tag lookup — reusable, admin-managed labels applied to records (m2m), not a
// free-text field. Applied to Contact and Company; extendable to other objects
// by adding the corresponding back-relation + join.
model Tag {
  id          String   @id @default(cuid())
  /// Display name (preserves casing the user typed)
  name        String
  /// Normalized dedupe key (trimmed + lowercased) — "VIP" and "vip" collapse here
  nameKey     String   @unique @map("name_key")
  color       String?
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  contacts  Contact[] @relation("ContactTags")
  companies Company[] @relation("CompanyTags")

  @@map("tags")
}

model User {
  id          String   @id @default(cuid())
  name        String?  @map("name")
  email       String?  @map("email")
  title       String?  @map("title")
  department  String?  @map("department")
  userRole    String?  @map("user_role")
  isActive    Boolean? @map("is_active")
  createdById String?  @map("created_by_id")
  createdBy   String?  @map("created_by")

  // --- relations ---
  ownedCompanies     Company[]      @relation("CompanyOwner")
  ownedContacts      Contact[]      @relation("ContactOwner")
  ownedOpportunities Opportunity[]  @relation("OpportunityOwner")
  messages           Message[]      @relation("MessageOwner")
  assignedConversations  Conversation[]          @relation("ConversationAssignee")
  roleRef            Role?          @relation("UserRole", fields: [userRole], references: [key])

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdById])
  @@map("users")
}

