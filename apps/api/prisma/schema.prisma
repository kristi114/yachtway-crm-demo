// Messages — individual communication activities on the timeline
// (Email · iMessage/SMS · Call · Chat · WhatsApp). One row per activity;
// channel-specific columns are a nullable superset keyed by `channel`. Each
// message belongs to a Conversation (thread); financing-classed rows carry
// sensitivity_class so RLS gates them per-row (same class as the parent thread).
model Message {
  id                     String    @id @default(cuid())
  conversationId         String?   @map("conversation_id")
  contactId              String?   @map("contact_id")
  companyId              String?   @map("company_id")
  relatedListingId       String?   @map("related_listing_id")
  channel                String?   @map("channel")
  direction              String?   @map("direction")
  subject                String?   @map("subject")
  body                   String?   @map("body")
  status                 String?   @map("status")
  activityTimestamp      DateTime? @map("activity_timestamp")
  ownerId                String?   @map("owner_id")
  attachmentCount        Decimal?  @map("attachment_count")
  createdById            String?   @map("created_by_id")
  fromAddress            String?   @map("from_address")
  toAddresses            String[]  @map("to_addresses")
  ccAddresses            String[]  @map("cc_addresses")
  emailSubject           String?   @map("email_subject")
  threadId               String?   @map("thread_id")
  openCount              Decimal?  @map("open_count")
  clickCount             Decimal?  @map("click_count")
  linkClicked            String?   @map("link_clicked")
  fromNumber             String?   @map("from_number")
  toNumber               String?   @map("to_number")
  messageType            String?   @map("message_type")
  deliveryStatus         String?   @map("delivery_status")
  callDirection          String?   @map("call_direction")
  callDurationSec        Decimal?  @map("call_duration_sec")
  callOutcome            String?   @map("call_outcome")
  recordingUrl           String?   @map("recording_url")
  voicemailTranscript    String?   @map("voicemail_transcript")
  dialogId               String?   @map("dialog_id")
  dialogContactType      String?   @map("dialog_contact_type")
  isSupportChat          Boolean?  @map("is_support_chat")
  isContactChat          Boolean?  @map("is_contact_chat")
  isAiChat               Boolean?  @map("is_ai_chat")
  senderMarkedForLaterAt DateTime? @map("sender_marked_for_later_at")
  contactFormId          String?   @map("contact_form_id")
  waMessageType          String?   @map("wa_message_type")
  templateName           String?   @map("template_name")
  waConversationId       String?   @map("wa_conversation_id")
  mediaUrl               String?   @map("media_url")
  /// transport provider (gmail | mailgun | …) and its id for the sent message,
  /// used to correlate provider tracking events back to this row
  provider               String?   @map("provider")
  providerMessageId      String?   @map("provider_message_id")
  /// RLS class: general | financing(easyfund) | mastercover — gates rep visibility
  sensitivityClass       String?   @map("sensitivity_class")

  // --- relations ---
  conversation         Conversation? @relation("ConversationMessages", fields: [conversationId], references: [id])
  contactRecord        Contact? @relation("MessageContact", fields: [contactId], references: [id])
  companyRecord        Company? @relation("MessageCompany", fields: [companyId], references: [id])
  relatedListingRecord Listing? @relation("MessageListing", fields: [relatedListingId], references: [id])
  ownerUser            User?    @relation("MessageOwner", fields: [ownerId], references: [id])

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([contactId])
  @@index([companyId])
  @@index([relatedListingId])
  @@index([ownerId])
  @@index([createdById])
  @@index([activityTimestamp])
  @@index([channel])
  @@index([providerMessageId])
  @@map("messages")
}

// Idempotency ledger for inbound provider webhooks (Mailgun events, later Gmail
// push). A row is claimed once per (provider, externalId) so a redelivered event
// (Mailgun retries, at-least-once) is processed exactly once — critical for
// counters like open_count that must not double-increment. System-only (RLS).
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String   @map("provider")
  externalId String   @map("external_id")
  eventType  String?  @map("event_type")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, externalId])
  @@map("webhook_events")
}

// Conversations — the thread container that groups Messages. This is the unit
// the inbox/board renders and that a company page rolls up across its contacts.
// sensitivity_class drives per-row RLS (general → conversations.general;
// financing/easyfund/mastercover → conversations.financing) exactly like Message.
model Conversation {
  id                 String    @id @default(cuid())
  contactId          String?   @map("contact_id")
  companyId          String?   @map("company_id")
  relatedListingId   String?   @map("related_listing_id")
  channel            String    @map("channel")
  status             String    @default("open") @map("status")
  subject            String?   @map("subject")
  assignedToId       String?   @map("assigned_to_id")
  /// RLS class: general | financing(easyfund) | mastercover — gates rep visibility
  sensitivityClass   String    @default("general") @map("sensitivity_class")
  /// provider thread id (set by the inbound webhook in the next increment) for upsert
  externalThreadId   String?   @map("external_thread_id")
  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")
  messageCount       Int       @default(0) @map("message_count")

  // --- relations ---
  contactRecord        Contact?  @relation("ConversationContact", fields: [contactId], references: [id])
  companyRecord        Company?  @relation("ConversationCompany", fields: [companyId], references: [id])
  relatedListingRecord Listing?  @relation("ConversationListing", fields: [relatedListingId], references: [id])
  assignedTo           User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  messages             Message[] @relation("ConversationMessages")
  readStates           ConversationReadState[] @relation("ConversationReadStates")

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([companyId])
  @@index([relatedListingId])
  @@index([assignedToId])
  @@index([status])
  @@index([channel])
  @@index([lastMessageAt])
  @@index([externalThreadId])
  @@map("conversations")
}

// Per-user read state for a conversation — powers unread badges. sensitivity_class
// is denormalized from the parent thread so RLS can gate these rows directly
// (avoids a subquery into conversations, which would fall through to 'general').
// userId is the auth subject (WorkOS sub / dev shim), NOT necessarily a CRM users
// row, so it is a plain indexed column with no FK — same rationale as message
// authorship (created_by_id).
model ConversationReadState {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  userId           String   @map("user_id")
  lastReadAt       DateTime @map("last_read_at")
  sensitivityClass String   @default("general") @map("sensitivity_class")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation("ConversationReadStates", fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_read_state")
}

// Analytics — connected external profiles and their periodic INSIGHTS
// (organic + paid) across YouTube, Google (Analytics/Ads/Business), LinkedIn,
// TikTok, and multiple Meta business profiles (Pages, IG, Ad Accounts). Insights-
// first: organic reach/engagement/followers matter as much as ad spend. Rolls up
// to Company; channel-specific extras land in `metrics` JSON.
model AnalyticsProfile {
  id                String    @id @default(cuid())
  /// Lookup(Company) — owning company (nullable: some profiles are house-level)
  companyId         String?   @map("company_id")
  /// Channel: youtube | google_analytics | google_ads | google_business |
  /// linkedin | tiktok | meta_page | meta_instagram | meta_ad_account | meta_business
  channel           String    @map("channel")
  /// External profile/account id on the platform (Page id, IG id, ad account id, ...)
  externalId        String?   @map("external_id")
  /// Meta Business account id — lets multiple Meta profiles roll up to one business
  businessAccountId String?   @map("business_account_id")
  displayName       String?   @map("display_name")
  handle            String?   @map("handle")
  profileUrl        String?   @map("profile_url")
  isActive          Boolean?  @map("is_active")
  connectedAt       DateTime? @map("connected_at")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  scopes            String[]  @map("scopes")

  companyRecord Company?            @relation("AnalyticsProfileCompany", fields: [companyId], references: [id])
  snapshots     AnalyticsSnapshot[]

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([channel, externalId])
  @@index([companyId])
  @@index([channel])
  @@map("analytics_profiles")
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  profileId   String   @map("profile_id")
  /// Period this snapshot covers
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  granularity String?  @map("granularity") // day | week | month | lifetime

  // --- organic / audience insights ---
  impressions       Decimal? @map("impressions")
  reach             Decimal? @map("reach")
  engagements       Decimal? @map("engagements")
  engagementRate    Decimal? @map("engagement_rate") @db.Decimal(6, 3)
  followers         Decimal? @map("followers")
  followersDelta    Decimal? @map("followers_delta")
  profileViews      Decimal? @map("profile_views")
  videoViews        Decimal? @map("video_views")
  watchTimeMinutes  Decimal? @map("watch_time_minutes")
  likes             Decimal? @map("likes")
  comments          Decimal? @map("comments")
  shares            Decimal? @map("shares")
  saves             Decimal? @map("saves")
  subscribersGained Decimal? @map("subscribers_gained")
  subscribersLost   Decimal? @map("subscribers_lost")

  // --- web / session insights (Google Analytics etc.) ---
  sessions              Decimal? @map("sessions")
  users                 Decimal? @map("users")
  newUsers              Decimal? @map("new_users")
  bounceRate            Decimal? @map("bounce_rate") @db.Decimal(6, 3)
  avgSessionDurationSec Decimal? @map("avg_session_duration_sec")

  // --- paid / ads insights ---
  clicks      Decimal? @map("clicks")
  linkClicks  Decimal? @map("link_clicks")
  ctr         Decimal? @map("ctr") @db.Decimal(6, 3)
  spend       Decimal? @map("spend") @db.Decimal(14, 2)
  cpc         Decimal? @map("cpc") @db.Decimal(14, 2)
  cpm         Decimal? @map("cpm") @db.Decimal(14, 2)
  conversions Decimal? @map("conversions")
  leads       Decimal? @map("leads")

  /// Channel-specific metrics that don't fit the columns above
  metrics Json? @map("metrics")

  profile AnalyticsProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([profileId])
  @@index([periodStart])
  @@map("analytics_snapshots")
}

// ============================================================================
// Amplitude destination (product analytics → CRM)
//
// The CRM is registered as an Amplitude "Webhook" destination for Events, User
// Properties and Cohorts. The join key is Amplitude's `user_id`, which the
// frontend sets to the YachtWay DB ID (Contact.yachtwayDbId). Rows carry the
// resolved contactId when a match exists, and always keep the raw Amplitude ids
// so a later backfill can reconcile events received before the contact existed.
// ============================================================================

model AmplitudeEvent {
  id String @id @default(cuid())
  /// Resolved CRM contact (nullable: event may arrive before the contact syncs).
  contactId String? @map("contact_id")
  /// Amplitude user_id === YachtWay DB ID (the identity contract).
  ampUserId String? @map("amp_user_id")
  deviceId  String? @map("device_id")
  /// Amplitude's internal numeric id (as string), when present.
  amplitudeId String? @map("amplitude_id")
  /// insert_id / event id — the idempotency key (a redelivery is dropped).
  externalId String @map("external_id")
  eventType  String @map("event_type")
  eventTime  DateTime? @map("event_time")
  sessionId  String? @map("session_id")
  eventProperties Json? @map("event_properties")
  userProperties  Json? @map("user_properties")
  receivedAt DateTime @default(now()) @map("received_at")

  contact Contact? @relation("AmplitudeEventContact", fields: [contactId], references: [id])

  @@unique([externalId])
  @@index([contactId])
  @@index([ampUserId])
  @@index([eventType])
  @@index([eventTime])
  @@map("amplitude_events")
}

model AmplitudeCohort {
  id String @id @default(cuid())
  /// Amplitude's cohort id — the external key we upsert on.
  amplitudeCohortId String  @unique @map("amplitude_cohort_id")
  name              String? @map("name")
  description       String? @map("description")
  memberCount       Int?    @map("member_count")
  lastSyncedAt      DateTime? @map("last_synced_at")

  memberships AmplitudeCohortMembership[] @relation("AmplitudeCohortMemberships")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("amplitude_cohorts")
}

model AmplitudeCohortMembership {
  id        String  @id @default(cuid())
  cohortId  String  @map("cohort_id")
  contactId String? @map("contact_id")
  /// Amplitude user_id === YachtWay DB ID.
  ampUserId String  @map("amp_user_id")
  addedAt   DateTime @default(now()) @map("added_at")

  cohort  AmplitudeCohort @relation("AmplitudeCohortMemberships", fields: [cohortId], references: [id], onDelete: Cascade)
  contact Contact?        @relation("AmplitudeCohortMembershipContact", fields: [contactId], references: [id])

  @@unique([cohortId, ampUserId])
  @@index([contactId])
  @@index([ampUserId])
  @@map("amplitude_cohort_memberships")
}

// ============================================================================
// Permission engine — roles, grants, and audit. The DB is the source of truth:
// RLS policies (prisma/policies/rls.sql) read permission_grants via the
// app.current_role session variable, so every query path is gated by Postgres.
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  /// Stable key matching @yachtway/shared RoleSchema: SALES_REP | FINTECH | MARKETING | ADMIN
  key         String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  grants PermissionGrant[]
  users  User[]            @relation("UserRole")

  @@map("roles")
}

model PermissionGrant {
  id String @id @default(cuid())
  /// FK -> Role
  roleId String @map("role_id")
  /// Matches @yachtway/shared ResourceClassSchema (company.general, easyfund, analytics, ...)
  resourceClass String   @map("resource_class")
  canRead       Boolean  @default(false) @map("can_read")
  canWrite      Boolean  @default(false) @map("can_write")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt      @map("updated_at")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resourceClass])
  @@index([roleId])
  @@map("permission_grants")
}

model AuditLog {
  id String @id @default(cuid())
  /// Actor — nullable so system/sync writes are still recorded
  actorUserId   String?  @map("actor_user_id")
  actorRole     String?  @map("actor_role")
  action        String // create | update | delete | read | export | login
  resourceClass String?  @map("resource_class")
  tableName     String?  @map("table_name")
  recordId      String?  @map("record_id")
  before        Json?
  after         Json?
  ipAddress     String?  @map("ip_address")
  at            DateTime @default(now())

  // actor_user_id is the auth subject (WorkOS sub / dev shim) — NOT necessarily a
  // users row, so it's a plain indexed column with NO FK (same convention as
  // Message.createdById / ConversationReadState.userId). See migration
  // 20260725190000_audit_actor_no_fk.

  @@index([actorUserId])
  @@index([tableName, recordId])
  @@index([at])
  @@map("audit_logs")
}

// ============================================================================
// Xero-via-Make billing (Phase X0). The CRM owns invoicing logic; Make is the
// Xero transport. Invoice/Payment/Bill/CreditNote carry a sensitivity_class that
// RLS gates per-row (easyfund/mastercover → invoice.financing / bill.financing,
// FINTECH/ADMIN only). Estimates are CRM-only (no Xero). createdById/approvedById
// are auth subjects (WorkOS sub / dev shim) — plain indexed columns, NOT FKs,
// same convention as Message.createdById.
// ============================================================================

/// A CRM invoice mirroring a Xero ACCREC invoice. Created as a local draft
/// (auto on Won or rep-initiated), sent to Xero via Make only after human
/// approval. A multi-opp studio invoice spans several opportunities via its
/// OpportunityLineItem children; opportunityId is the primary opp.
model Invoice {
  id                String    @id @default(cuid())
  opportunityId     String?   @map("opportunity_id")
  companyId         String?   @map("company_id")
  contactId         String?   @map("contact_id")
  /// Set (unique) when converted from an accepted estimate — powers Estimate 1:1.
  fromEstimateId    String?   @unique @map("from_estimate_id")
  invoiceType       String    @map("invoice_type")
  /// card payment rail: 'stripe' (pay link) | 'manual' (bank/check, recorded by hand).
  billingProvider   String    @default("stripe") @map("billing_provider")
  orgKey            String?   @map("org_key")
  currency          String    @default("USD") @map("currency")
  amount            Decimal?  @map("amount") @db.Decimal(14, 2)
  reference         String?   @map("reference")
  itemized          Boolean   @default(false) @map("itemized")
  status            String    @default("draft") @map("status")
  amountPaid        Decimal?  @map("amount_paid") @db.Decimal(14, 2)
  amountDue         Decimal?  @map("amount_due") @db.Decimal(14, 2)
  dueDate           DateTime? @map("due_date") @db.Date
  /// when the invoice PDF was emailed to the payer
  sentAt            DateTime? @map("sent_at")
  /// stored path/URL of the generated invoice PDF
  pdfPath           String?   @map("pdf_path")
  /// Stripe id (Checkout session) when billingProvider='stripe'
  stripeInvoiceId   String?   @unique @map("stripe_invoice_id")
  /// Stripe Checkout / hosted pay URL sent to the payer
  onlineInvoiceUrl  String?   @map("online_invoice_url")
  /// general | financing | easyfund | mastercover — drives invoice.* RLS
  sensitivityClass  String    @default("general") @map("sensitivity_class")
  /// {opportunityId}:{invoiceType} (single) or hash of the opp-id set (multi) — hard dedupe
  idempotencyKey    String?   @unique @map("idempotency_key")
  syncError         String?   @map("sync_error")
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  createdById       String?   @map("created_by_id")

  // --- relations ---
  opportunity  Opportunity?          @relation("InvoiceOpportunity", fields: [opportunityId], references: [id])
  company      Company?              @relation("InvoiceCompany", fields: [companyId], references: [id])
  contact      Contact?              @relation("InvoiceContact", fields: [contactId], references: [id])
  fromEstimate Estimate?             @relation("EstimateInvoice", fields: [fromEstimateId], references: [id])
  payments     Payment[]             @relation("PaymentInvoice")
  lineItems    OpportunityLineItem[] @relation("InvoiceLineItems")

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@index([companyId])
  @@index([contactId])
  @@index([invoiceType])
  @@index([status])
  @@index([sensitivityClass])
  @@map("invoices")
}

/// A payment against an invoice (inbound from Xero via Make "Watch Payments").
/// sensitivity_class is denormalized from the invoice so RLS gates by a direct
/// column check (same rationale as ConversationReadState).
model Payment {
  id               String    @id @default(cuid())
  /// nullable: a recurring Stripe subscription payment has no CRM invoice
  invoiceId        String?   @map("invoice_id")
  companyId        String?   @map("company_id")
  subscriptionId   String?   @map("subscription_id")
  /// Stripe charge/payment id (when method='stripe')
  stripePaymentId  String?   @unique @map("stripe_payment_id")
  billingProvider  String    @default("stripe") @map("billing_provider")
  /// how the payment was received: stripe | bank_transfer | check | wire | manual
  method           String?   @map("method")
  /// CRM user who recorded a manual payment (null for Stripe-webhook payments)
  recordedById     String?   @map("recorded_by_id")
  amount           Decimal?  @map("amount") @db.Decimal(14, 2)
  paidAt           DateTime? @map("paid_at") @db.Date
  reference        String?   @map("reference")
  sensitivityClass String    @default("general") @map("sensitivity_class")

  invoice      Invoice?      @relation("PaymentInvoice", fields: [invoiceId], references: [id], onDelete: Cascade)
  company      Company?      @relation("PaymentCompany", fields: [companyId], references: [id])
  subscription Subscription? @relation("PaymentSubscription", fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([companyId])
  @@index([subscriptionId])
  @@map("payments")
}

/// A payable (Xero ACCPAY) — studio spend + easyfund/mastercover bills. Inbound
/// only in v1 (Make "Watch Bills"); the CRM does not create bills in Xero.
model Bill {
  id               String    @id @default(cuid())
  companyId        String?   @map("company_id")
  contactId        String?   @map("contact_id")
  billType         String?   @map("bill_type")
  billingProvider  String    @default("xero") @map("billing_provider")
  orgKey           String?   @map("org_key")
  currency         String    @default("USD") @map("currency")
  amount           Decimal?  @map("amount") @db.Decimal(14, 2)
  status           String    @default("awaiting_payment") @map("status")
  amountPaid       Decimal?  @map("amount_paid") @db.Decimal(14, 2)
  dueDate          DateTime? @map("due_date") @db.Date
  /// general (studio spend) | financing (easyfund/mastercover) — drives bill.* RLS
  sensitivityClass String    @default("general") @map("sensitivity_class")
  syncError        String?   @map("sync_error")

  company Company? @relation("BillCompany", fields: [companyId], references: [id])
  contact Contact? @relation("BillContact", fields: [contactId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([contactId])
  @@index([sensitivityClass])
  @@map("bills")
}

/// A dealer credit note (Xero ACCRECCREDIT). Inbound only (Make "Watch Credit
/// Notes"). The sum feeds the rep-visible dealerCredits rollup on Company.
model CreditNote {
  id               String    @id @default(cuid())
  companyId          String?   @map("company_id")
  contactId          String?   @map("contact_id")
  /// invoice this credit was applied against (optional)
  appliedToInvoiceId String?   @map("applied_to_invoice_id")
  amount             Decimal?  @map("amount") @db.Decimal(14, 2)
  remainingCredit    Decimal?  @map("remaining_credit") @db.Decimal(14, 2)
  /// open | applied | void
  status             String    @default("open") @map("status")
  currency           String    @default("USD") @map("currency")
  reference          String?   @map("reference")
  sensitivityClass   String    @default("general") @map("sensitivity_class")
  issuedById         String?   @map("issued_by_id")

  company Company? @relation("CreditNoteCompany", fields: [companyId], references: [id])
  contact Contact? @relation("CreditNoteContact", fields: [contactId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([contactId])
  @@map("credit_notes")
}

/// A recurring subscription billed through Stripe (Stripe owns the schedule; the
/// CRM mirrors status/payments via webhooks). Maps Stripe Customer ↔
/// Company.stripeCustomerId. General sensitivity.
model Subscription {
  id                   String    @id @default(cuid())
  companyId            String?   @map("company_id")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripePriceId        String?   @map("stripe_price_id")
  productName          String?   @map("product_name")
  status               String?   @map("status") // active | trialing | past_due | canceled | incomplete
  seats                Int?      @map("seats")
  mrr                  Decimal?  @map("mrr") @db.Decimal(14, 2)
  currency             String    @default("USD") @map("currency")
  currentPeriodEnd     DateTime? @map("current_period_end")
  billingProvider      String    @default("stripe") @map("billing_provider")
  sensitivityClass     String    @default("general") @map("sensitivity_class")
  createdById          String?   @map("created_by_id")

  company  Company?  @relation("SubscriptionCompany", fields: [companyId], references: [id])
  payments Payment[] @relation("PaymentSubscription")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("subscriptions")
}

/// Internal, non-monetary ledger of Studio Listing Shoot credits granted/consumed
/// per dealer (per shoot, flat — independent of vessel length). CRM-only, never
/// in Xero. Balance is materialized onto Company.freeListingShootsRemaining.
model StudioShootCredit {
  id                   String   @id @default(cuid())
  companyId            String   @map("company_id")
  /// +n granted, -1 consumed per shoot
  delta                Int      @map("delta")
  reason               String?  @map("reason")
  relatedOpportunityId String?  @map("related_opportunity_id")
  note                 String?  @map("note")
  createdById          String?  @map("created_by_id")

  company            Company      @relation("ShootCreditCompany", fields: [companyId], references: [id], onDelete: Cascade)
  relatedOpportunity Opportunity? @relation("ShootCreditOpportunity", fields: [relatedOpportunityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([relatedOpportunityId])
  @@map("studio_shoot_credits")
}

/// Amount a lender (easyfund) or insurer (mastercover) owes YachtWay for a closed
/// deal. NOT invoiced — auto-accrued on the opportunity's close-stage trigger, then
/// cleared when the partner's monthly (15th) lump settlement payment is recorded.
/// One per opportunity. Financing sensitivity (FINTECH/ADMIN only).
model PartnerReceivable {
  id                     String    @id @default(cuid())
  companyId              String    @map("company_id")
  opportunityId          String    @unique @map("opportunity_id")
  /// easyfund | mastercover
  kind                   String    @map("kind")
  amount                 Decimal?  @map("amount") @db.Decimal(14, 2)
  currency               String    @default("USD") @map("currency")
  closedAt               DateTime  @map("closed_at") @db.Date
  /// next 15th on/after closedAt — when the partner is expected to pay
  expectedSettlementDate DateTime  @map("expected_settlement_date") @db.Date
  /// accrued | settled | void
  status                 String    @default("accrued") @map("status")
  settlementPaymentId    String?   @map("settlement_payment_id")
  sensitivityClass       String    @default("financing") @map("sensitivity_class")

  company     Company     @relation("PartnerReceivableCompany", fields: [companyId], references: [id])
  opportunity Opportunity @relation("PartnerReceivableOpportunity", fields: [opportunityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@index([expectedSettlementDate])
  @@map("partner_receivables")
}

/// Money owed/paid TO a dealer (referral payouts). Auto-drafted on a financing
/// deal's close trigger when the deal carries `paid_to_referring_dealer`; finance
/// approves + marks paid (bank transfer today). Recorded now; Stripe Connect
/// execution can slot in later (stripeTransferId). Financing sensitivity.
model Payout {
  id                   String    @id @default(cuid())
  companyId            String    @map("company_id")
  amount               Decimal?  @map("amount") @db.Decimal(14, 2)
  currency             String    @default("USD") @map("currency")
  /// pending | approved | paid | void
  status               String    @default("pending") @map("status")
  /// bank_transfer | check | wire | stripe_connect | manual
  method               String?   @map("method")
  /// referral_field (auto from paid_to_referring_dealer) | manual
  amountSource         String    @default("referral_field") @map("amount_source")
  reference            String?   @map("reference")
  paidAt               DateTime? @map("paid_at") @db.Date
  /// set (unique) when auto-drafted from a closed deal — one payout per deal
  relatedOpportunityId String?   @unique @map("related_opportunity_id")
  stripeTransferId     String?   @map("stripe_transfer_id")
  sensitivityClass     String    @default("financing") @map("sensitivity_class")
  approvedById         String?   @map("approved_by_id")
  createdById          String?   @map("created_by_id")

  company            Company      @relation("PayoutCompany", fields: [companyId], references: [id])
  relatedOpportunity Opportunity? @relation("PayoutOpportunity", fields: [relatedOpportunityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("payouts")
}

/// A CRM-only client estimate (no Xero object). Drafted, sent to a company
/// contact who accepts/declines via a public HMAC-signed link; on acceptance it
/// converts to an Invoice draft (Invoice.fromEstimateId, 1:1).
model Estimate {
  id                        String    @id @default(cuid())
  companyId                 String?   @map("company_id")
  currency                  String    @default("EUR") @map("currency")
  notes                     String?   @map("notes")
  status                    String    @default("draft") @map("status")
  primaryRecipientContactId String?   @map("primary_recipient_contact_id")
  ccEmails                  String[]  @map("cc_emails")
  total                     Decimal?  @map("total") @db.Decimal(14, 2)
  sensitivityClass          String    @default("general") @map("sensitivity_class")
  sentAt                    DateTime? @map("sent_at")
  respondedAt               DateTime? @map("responded_at")
  /// opaque token backing the public accept/decline link
  acceptToken               String?   @unique @map("accept_token")
  createdById               String?   @map("created_by_id")

  company          Company?           @relation("EstimateCompany", fields: [companyId], references: [id])
  primaryRecipient Contact?           @relation("EstimateRecipient", fields: [primaryRecipientContactId], references: [id])
  lineItems        EstimateLineItem[] @relation("EstimateLines")
  convertedInvoice Invoice?           @relation("EstimateInvoice")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([primaryRecipientContactId])
  @@index([status])
  @@map("estimates")
}

/// Ad-hoc estimate line (free-text description + qty + price). Optional
/// productCode links to the Product catalog for studio items.
model EstimateLineItem {
  id          String   @id @default(cuid())
  estimateId  String   @map("estimate_id")
  description String?  @map("description")
  quantity    Decimal? @map("quantity")
  unitPrice   Decimal? @map("unit_price") @db.Decimal(14, 2)
  productCode String?  @map("product_code")
  lineTotal   Decimal? @map("line_total") @db.Decimal(14, 2)
  position    Int?     @map("position")

  estimate Estimate @relation("EstimateLines", fields: [estimateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estimateId])
  @@map("estimate_line_items")
}
