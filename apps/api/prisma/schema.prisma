  insurerCompany  Company?    @relation("MasterCoverInsurer", fields: [insurerId], references: [id])
  referringDealer Company?    @relation("MasterCoverReferringDealer", fields: [referringDealerId], references: [id])

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([opportunityId])
  @@index([insurerId])
  @@index([referringDealerId])
  @@map("mastercover_applications")
}

