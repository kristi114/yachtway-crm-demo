  /// 1:1 -> Opportunity
  opportunityId String @unique @map("opportunity_id")
  /// Dealer Id [Lookup(Account) · Lookup]
  /// FK -> Account (add @relation by hand)
  dealerId                           String?     @map("dealer_id")
  /// Dealer [Text(lookup) · Lookup]
  dealer                             String?     @map("dealer")
  /// Co-applicant Id [Lookup(Contact) · Lookup]
  /// FK -> Contact (add @relation by hand)
  coapplicantId                      String?     @map("coapplicant_id")
  /// Co-applicant [Text(lookup) · Lookup]
  coapplicant                        String?     @map("coapplicant")
  /// Lender Id [Lookup(Account) · Lookup]
  /// FK -> Account (add @relation by hand)
  lenderId                           String?     @map("lender_id")
  /// Lender [Text(lookup) · Lookup]
  lender                             String?     @map("lender")
  /// Added to Dealer Closed Referrals [Checkbox · Make]
  addedToDealerClosedReferrals       Boolean?    @map("added_to_dealer_closed_referrals")
  /// Added to Dealer Total Referrals [Checkbox · Make]
  addedToDealerTotalReferrals        Boolean?    @map("added_to_dealer_total_referrals")
  /// Amount From Lender [Currency · Internal]
  amountFromLender                   Decimal?    @map("amount_from_lender") @db.Decimal(14, 2)
  /// Approved Conditions [Multi-Picklist · Internal]
  /// options: Address of Storage or Mooring Location; Confirmation of intended use (recreational only, no commercial/charter use); Copy of Identification; CSI (Condition & Serial Number) Inspection (if survey waived); Executed Purchase Agreement or Bill of Sale; Full Marine Survey (Condition & Valuation); Insurance Binder naming lender as loss payee- Must meet lender liability and hull coverage minimums; Manufacturer Certificate of Origin (for new vessels) … (17 total)
  approvedConditions                 String[]    @map("approved_conditions")
  /// Approved Conditions Notes [Long Text · Internal]
  approvedConditionsNotes            String?     @map("approved_conditions_notes")
  /// Close Date [Date · Internal]
  closeDate                          DateTime?   @map("close_date") @db.Date
  /// Co-applicant Credit Score [Picklist · Platform]
  /// options: Under 650; 650-699; 700-739; 740-799; 800+
  coApplicantCreditScore             String?     @map("co_applicant_credit_score")
  /// Co-applicant Monthly Debt [Currency · Platform]
  coApplicantMonthlyDebt             Decimal?    @map("co_applicant_monthly_debt") @db.Decimal(14, 2)
  /// Co-Applicant Monthly Income [Currency · Platform]
  coApplicantMonthlyIncome           Decimal?    @map("co_applicant_monthly_income") @db.Decimal(14, 2)
  /// Co-Applicant Monthly Income Range [Picklist · Platform]
  /// options: Under $10,000; $10,000-$24,999; $25,000-$49,999; $50,00-$99,999; $100,000-$499,999; $500,000+
  coApplicantMonthlyIncomeRange      String?     @map("co_applicant_monthly_income_range")
  /// Credit Score Band [Picklist · Platform]
  /// options: Under 650; 650-699; 700-739; 740-799; 800+
  creditScore                        String?     @map("credit_score")
  /// Currently Financed Through [Text · Internal]
  currentlyFinancedThrough           String?     @map("currently_financed_through")
  /// Dealer Referral Bonus [Currency · Internal]
  dealerReferralBonus                Decimal?    @map("dealer_referral_bonus") @db.Decimal(14, 2)
  /// Decline Notes [Long Text · Internal]
  declineNotes                       String?     @map("decline_notes")
  /// Decline Reason [Picklist · Internal]
  /// options: Borrower Communication- Application Withdrawn by Borrower; Borrower Communication- Borrower Decided Not to Move Forward; Borrower Communication- Borrower Unreachable; Borrower Communication- Borrower Unresponsive to Follow-Up; Borrower Communication- Incomplete Application; Collateral/Vessel- Ineligible Vessel Type (Houseboat, Liveaboard, etc.); Collateral/Vessel- Required Vessel Documentation Not Provided; Collateral/Vessel- Survey Failed (Structural/Mechanical Issues) … (24 total)
  declineReason                      String?     @map("decline_reason")
  /// Down Payment [Currency · Platform]
  downPayment                        Decimal?    @map("down_payment") @db.Decimal(14, 2)
  /// Engine Make [Text · Platform]
  engineMake                         String?     @map("engine_make")
  /// Engine Type [Picklist · Platform]
  /// options: Outboard; IPS Pod Drive; Sterndrive; V-Drive; Jet Drive; Surface Drive; Shaft Drive; Sail Drive … (13 total)
  engineType                         String?     @map("engine_type")
  /// Has Co-Applicant? [Checkbox · Platform]
  hasCoApplicant                     Boolean?    @map("has_co_applicant")
  /// Horsepower [Number · Platform]
  horsepower                         Decimal?    @map("horsepower")
  /// Interest Rate % [Percent · Internal]
  interestRate                       Decimal?    @map("interest_rate") @db.Decimal(6, 3)
  /// Lead Source [Picklist · Platform]
  leadSource                         String?     @map("lead_source")
  /// Loan Amount [Currency · Internal]
  loanAmount                         Decimal?    @map("loan_amount") @db.Decimal(14, 2)
  /// Loan Term (mo) [Number · Internal]
  loanTerm                           Decimal?    @map("loan_term")
  /// Loan Type [Picklist · Platform]
  /// options: Fixed rate; ARM; Interest Only
  loanType                           String?     @map("loan_type")
  /// Monthly Debt [Currency · Platform]
  monthlyDebt                        Decimal?    @map("monthly_debt") @db.Decimal(14, 2)
  /// Monthly Income [Currency · Platform]
  monthlyIncome                      Decimal?    @map("monthly_income") @db.Decimal(14, 2)
  /// Monthly Income [Picklist · Platform]
  /// options: Under $10,000; $10,000-$24,999; $25,000-$49,999; $50,00-$99,999; $100,000-$499,999; $500,000+
  monthlyIncomeRange                 String?     @map("monthly_income_range")
  /// Monthly Payment [Currency · Internal]
  monthlyPayment                     Decimal?    @map("monthly_payment") @db.Decimal(14, 2)
  /// Number of Engines [Number · Platform]
  numberOfEngines                    Decimal?    @map("number_of_engines")
  /// Opportunity Created [Date · System]
  opportunityCreated                 DateTime?   @map("opportunity_created") @db.Date
  /// Paid to Referring Dealer [Currency · Make]
  paidToReferringDealer              Decimal?    @map("paid_to_referring_dealer") @db.Decimal(14, 2)
  /// Prequal ID [Text(External Id) · Platform]
  prequalificationId                 String?     @map("prequalification_id") @unique
  /// Purchase Price [Currency · Platform]
  purchasePrice                      Decimal?    @map("purchase_price") @db.Decimal(14, 2)
  /// Purchase/Refinance [Picklist · Platform]
  /// options: Purchase; Refinance
  purchaseRefinance                  String?     @map("purchase_refinance")
  /// Referral % to Dealer [Number · Internal]
  referralToDealer                   Decimal?    @map("referral_to_dealer")
  /// Referral Fee Added to Dealer Account [Checkbox · Make]
  referralFeeAddedToDealerAccount    Boolean?    @map("referral_fee_added_to_dealer_account")
  /// Reserve [Number · Internal]
  reserve                            Decimal?    @map("reserve")
  /// Vessel Listing URL [Text · Platform]
  vesselListingUrl                   String?     @map("vessel_listing_url")
  /// YachtWay EasyFund External ID [Text(External Id) · Platform]
  easyfundExternalId                 String?     @map("easyfund_external_id") @unique

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@map("easyfund_loans")
}

model MasterCoverApplication {
