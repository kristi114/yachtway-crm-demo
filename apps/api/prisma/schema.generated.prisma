  /// Tender Num of Engines [Number · Platform]
  tenderNumOfEngines                 Decimal?    @map("tender_num_of_engines")
  /// Tender Year [Number · Platform]
  tenderYear                         Decimal?    @map("tender_year")
  /// Tender? [Checkbox · Platform]
  tender                             Boolean?    @map("tender")
  /// Trailer Make [Text · Platform]
  trailerMake                        String?     @map("trailer_make")
  /// Trailer Model [Text · Platform]
  trailerModel                       String?     @map("trailer_model")
  /// Trailer Year [Number · Platform]
  trailerYear                        Decimal?    @map("trailer_year")
  /// Trailer? [Checkbox · Platform]
  trailer                            Boolean?    @map("trailer")
  /// Used for Charter [Checkbox · Platform]
