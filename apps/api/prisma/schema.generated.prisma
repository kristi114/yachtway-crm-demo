  vesselType                         String?     @map("vessel_type")
  /// Vessel Value [Currency · Platform]
  vesselValue                        Decimal?    @map("vessel_value") @db.Decimal(14, 2)
  /// Year of Engine [Number · Platform]
  yearOfEngine                       Decimal?    @map("year_of_engine")

  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  @@map("mastercover_applications")
}

