{
  "name": "@yachtway/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "lint": "echo \"(lint placeholder)\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:policies": "tsx prisma/apply-policies.ts",
    "db:setup": "prisma migrate dev && tsx prisma/apply-policies.ts && tsx prisma/seed.ts",
    "prisma:gen-schema": "tsx prisma/generate-schema.ts",
    "prisma:validate-generated": "prisma validate --schema prisma/schema.generated.prisma",
    "spike:apply": "tsx src/spike/apply.ts",
    "spike:test": "vitest run -c vitest.spike.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@yachtway/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
